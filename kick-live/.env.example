# Copy to ~/.config/kick-live/env (mode 600). Never commit the real file.
KICK_CHANNEL=atleastonce
KICK_CHATROOM_ID=41370704
KICK_CHANNEL_ID=41659037
RTMPS_URL=rtmps://fa723fc1b171.global-contribute.live-video.net:443/app/
STREAM_KEY=
SRT_URL=srt://fa723fc1b171.srt.live-video.net:9000
SRT_PASSPHRASE=
KICK_TOKEN=
# Kick developer app (https://kick.com/settings/developer). Enables title/category updates and bot chat.
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=
KICK_APP_PORT=8080
# ngrok tunnel for the OAuth redirect URI
NGROK_AUTHTOKEN=
NGROK_DOMAIN=
# Registered on the Kick developer app (must match exactly)
KICK_REDIRECT_URI=https://<ngrok-domain>/oauth/callback
KICK_WEBHOOK_URL=https://<ngrok-domain>/webhooks/kick
# Canonical runtime dir shared by all sessions/checkouts (state, chat, metrics, logs)
RUN_DIR=/Users/sandy/.local/share/kick-live/run
