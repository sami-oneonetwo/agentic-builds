# Copy to ~/.config/kick-live/env (mode 600). Never commit the real file.
KICK_CHANNEL=atleastonce
KICK_CHATROOM_ID=41370704
KICK_CHANNEL_ID=41659037
RTMPS_URL=rtmps://fa723fc1b171.global-contribute.live-video.net:443/app/
STREAM_KEY=
SRT_URL=srt://fa723fc1b171.srt.live-video.net:9000
SRT_PASSPHRASE=
KICK_TOKEN=
# --- Kick developer app (https://kick.com/settings/developer, account needs 2FA) ---
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=
KICK_APP_PORT=8787
# Default scopes requested by `scripts/kick-app.sh login`
KICK_SCOPES=user:read channel:read channel:write chat:write events:subscribe
# --- ngrok tunnel in front of the receiver (scripts/tunnel.sh) ---
# https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=
# Reserved static domain, e.g. something.ngrok-free.app (https://dashboard.ngrok.com/domains).
# Without it the public URL changes on every restart and the URLs registered on the Kick app break.
NGROK_DOMAIN=
